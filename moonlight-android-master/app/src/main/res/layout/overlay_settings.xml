<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0F0F1A"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/settingsOverlay"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header with Moon Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙"
                android:textSize="32sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUNA REMOTE"
                android:textSize="20sp"
                android:textColor="#00FF00"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Connection Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO DE CONEXIÓN"
                android:textSize="12sp"
                android:textColor="#00FF00"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONECTADO"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvConnectedTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC GAMER"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvIpAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.25"
                android:textSize="12sp"
                android:textColor="#AAAAAA"/>
        </LinearLayout>

        <!-- Performance Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RENDIMIENTO"
                android:textSize="12sp"
                android:textColor="#00FF00"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="60 FPS"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="23 MS"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Excelente"
                    android:textSize="14sp"
                    android:textColor="#00FF00"
                    android:gravity="center"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1920 x 1080 RESOLUCIÓN"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Quick Access -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESOS RÁPIDOS"
                android:textSize="12sp"
                android:textColor="#00FF00"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnShutdown"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="⏻ Apagar"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:backgroundTint="#1A1A2E"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🔄 Reiniciar"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:backgroundTint="#1A1A2E"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🚪 Cerrar sesión"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:backgroundTint="#1A1A2E"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnLock"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🔒 Bloquear"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:backgroundTint="#1A1A2E"/>
        </LinearLayout>

        <!-- Transmission Quality -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALIDAD DE TRANSMISIÓN"
                android:textSize="12sp"
                android:textColor="#00FF00"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvQualityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Automática"
                android:textSize="14sp"
                android:textColor="#00FF00"
                android:layout_marginBottom="8dp"/>

            <SeekBar
                android:id="@+id/seekBarQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="4"
                android:progress="2"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Baja"
                    android:textSize="10sp"
                    android:textColor="#AAAAAA"
                    android:gravity="start"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Épica"
                    android:textSize="10sp"
                    android:textColor="#AAAAAA"
                    android:gravity="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Resolution -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A2E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESOLUCIÓN"
                android:textSize="12sp"
                android:textColor="#00FF00"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvResolutionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1920 x 1080 (1080p)"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinnerResolution"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1A1A2E"/>
        </LinearLayout>

        <!-- Close Settings Button -->
        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✕ Cerrar"
            android:textSize="16sp"
            android:textColor="#00FF00"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:backgroundTint="#1A1A2E"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
