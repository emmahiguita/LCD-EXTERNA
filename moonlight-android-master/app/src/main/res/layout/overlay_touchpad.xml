<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <!-- Trackpad Area (100% transparent, captures touch everywhere) -->
    <View
        android:id="@+id/touchArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <!-- Button to toggle mouse buttons visibility -->
    <Button
        android:id="@+id/btnToggleMouseButtons"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glass_button"
        android:text="🖱"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:alpha="0.5" />

    <!-- Mouse Buttons Container at bottom right -->
    <LinearLayout
        android:id="@+id/mouseButtonsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:layout_toLeftOf="@+id/btnToggleMouseButtons"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:background="#00000000"
        android:visibility="gone">

        <Button
            android:id="@+id/btnLmb"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_button"
            android:text="LMB"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:padding="0dp"
            android:layout_marginRight="8dp"/>

        <Button
            android:id="@+id/btnMmb"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_button"
            android:text="MMB"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:padding="0dp"
            android:layout_marginRight="8dp"/>

        <Button
            android:id="@+id/btnRmb"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_button"
            android:text="RMB"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:padding="0dp"
            android:layout_marginRight="16dp"/>

    </LinearLayout>

</RelativeLayout>
