<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_keyboard.xml (Professional DEV Keyboard - REDESIGNED)
  ─────────────────────────────────────────────────────────────────
  • Anchored to bottom of screen (layout_gravity="bottom").
  • Two tabs: NORMAL (QWERTY) and DEV (modifiers + symbols + shortcuts).
  • Drag handle on top bar allows repositioning vertically/horizontally.
  • Compact mode collapses to a single input bar.
  ─────────────────────────────────────────────────────────────────
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/bg_keyboard_panel"
    android:paddingTop="0dp"
    android:paddingBottom="4dp"
    android:elevation="18dp">

    <!-- ── TOP CONTROL BAR ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/keyboardTopBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_keyboard_topbar">

        <!-- Drag indicator -->
        <View
            android:id="@+id/keyboardDragHandle"
            android:layout_width="60dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_drag_handle"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <!-- Tab: NORMAL -->
        <TextView
            android:id="@+id/tabNormal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="NORMAL"
            android:textColor="#BB86FC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_tab_active" />

        <!-- Tab: DEV -->
        <TextView
            android:id="@+id/tabDev"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="DEV"
            android:textColor="#888"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_tab_inactive" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Keyboard Scale Down (⌨-) -->
        <TextView
            android:id="@+id/btnKbScaleDown"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⌨-"
            android:textColor="#AAA"
            android:textSize="13sp"
            android:layout_marginEnd="4dp" />

        <!-- Keyboard Scale Up (⌨+) -->
        <TextView
            android:id="@+id/btnKbScaleUp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⌨+"
            android:textColor="#AAA"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <!-- One-Handed mode toggle (1H) -->
        <TextView
            android:id="@+id/btnKbOneHanded"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="1H"
            android:textColor="#AAA"
            android:textSize="13sp"
            android:layout_marginEnd="4dp" />

        <!-- Compact toggle -->
        <TextView
            android:id="@+id/btnKbCompact"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⊟"
            android:textColor="#AAA"
            android:textSize="16sp"
            android:layout_marginEnd="4dp" />

        <!-- Close -->
        <TextView
            android:id="@+id/btnKbClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#CF6679"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ── COMPACT BAR (hidden when full keyboard is visible) ─────── -->
    <LinearLayout
        android:id="@+id/compactBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ctrl" style="@style/KeyChip" android:id="@+id/compCtrl" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Alt" style="@style/KeyChip" android:id="@+id/compAlt" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Shift" style="@style/KeyChip" android:id="@+id/compShift" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tab" style="@style/KeyChip" android:id="@+id/compTab" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Esc" style="@style/KeyChip" android:id="@+id/compEsc" />
        
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⌫" style="@style/KeyChip" android:id="@+id/compBsp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="↵" style="@style/KeyChipAccent" android:id="@+id/compEnter" />
        
        <!-- Expand Button (using same toggle ID) -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⊞" style="@style/KeyChipAccent" android:id="@+id/btnKbExpand" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════
         NORMAL KEYBOARD TAB
    ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/normalKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Row 1: Numbers -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_1"  style="@style/KeyboardKey" android:text="1"  android:layout_weight="1" />
            <Button android:id="@+id/kb_2"  style="@style/KeyboardKey" android:text="2"  android:layout_weight="1" />
            <Button android:id="@+id/kb_3"  style="@style/KeyboardKey" android:text="3"  android:layout_weight="1" />
            <Button android:id="@+id/kb_4"  style="@style/KeyboardKey" android:text="4"  android:layout_weight="1" />
            <Button android:id="@+id/kb_5"  style="@style/KeyboardKey" android:text="5"  android:layout_weight="1" />
            <Button android:id="@+id/kb_6"  style="@style/KeyboardKey" android:text="6"  android:layout_weight="1" />
            <Button android:id="@+id/kb_7"  style="@style/KeyboardKey" android:text="7"  android:layout_weight="1" />
            <Button android:id="@+id/kb_8"  style="@style/KeyboardKey" android:text="8"  android:layout_weight="1" />
            <Button android:id="@+id/kb_9"  style="@style/KeyboardKey" android:text="9"  android:layout_weight="1" />
            <Button android:id="@+id/kb_0"  style="@style/KeyboardKey" android:text="0"  android:layout_weight="1" />
            <Button android:id="@+id/kb_bspc" style="@style/KeyboardKeyAccent" android:text="⌫" android:layout_weight="1.5" />
        </LinearLayout>

        <!-- Row 2: QWERTY -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_q" style="@style/KeyboardKey" android:text="q" android:layout_weight="1" />
            <Button android:id="@+id/kb_w" style="@style/KeyboardKey" android:text="w" android:layout_weight="1" />
            <Button android:id="@+id/kb_e" style="@style/KeyboardKey" android:text="e" android:layout_weight="1" />
            <Button android:id="@+id/kb_r" style="@style/KeyboardKey" android:text="r" android:layout_weight="1" />
            <Button android:id="@+id/kb_t" style="@style/KeyboardKey" android:text="t" android:layout_weight="1" />
            <Button android:id="@+id/kb_y" style="@style/KeyboardKey" android:text="y" android:layout_weight="1" />
            <Button android:id="@+id/kb_u" style="@style/KeyboardKey" android:text="u" android:layout_weight="1" />
            <Button android:id="@+id/kb_i" style="@style/KeyboardKey" android:text="i" android:layout_weight="1" />
            <Button android:id="@+id/kb_o" style="@style/KeyboardKey" android:text="o" android:layout_weight="1" />
            <Button android:id="@+id/kb_p" style="@style/KeyboardKey" android:text="p" android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 3: ASDF -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_a"     style="@style/KeyboardKey"     android:text="a"    android:layout_weight="1" />
            <Button android:id="@+id/kb_s"     style="@style/KeyboardKey"     android:text="s"    android:layout_weight="1" />
            <Button android:id="@+id/kb_d"     style="@style/KeyboardKey"     android:text="d"    android:layout_weight="1" />
            <Button android:id="@+id/kb_f"     style="@style/KeyboardKey"     android:text="f"    android:layout_weight="1" />
            <Button android:id="@+id/kb_g"     style="@style/KeyboardKey"     android:text="g"    android:layout_weight="1" />
            <Button android:id="@+id/kb_h"     style="@style/KeyboardKey"     android:text="h"    android:layout_weight="1" />
            <Button android:id="@+id/kb_j"     style="@style/KeyboardKey"     android:text="j"    android:layout_weight="1" />
            <Button android:id="@+id/kb_k"     style="@style/KeyboardKey"     android:text="k"    android:layout_weight="1" />
            <Button android:id="@+id/kb_l"     style="@style/KeyboardKey"     android:text="l"    android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 4: ZXCV + arrows -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_shift" style="@style/KeyboardKeyAccent" android:text="⇧"  android:layout_weight="1.5" />
            <Button android:id="@+id/kb_z"     style="@style/KeyboardKey"       android:text="z"  android:layout_weight="1" />
            <Button android:id="@+id/kb_x"     style="@style/KeyboardKey"       android:text="x"  android:layout_weight="1" />
            <Button android:id="@+id/kb_c"     style="@style/KeyboardKey"       android:text="c"  android:layout_weight="1" />
            <Button android:id="@+id/kb_v"     style="@style/KeyboardKey"       android:text="v"  android:layout_weight="1" />
            <Button android:id="@+id/kb_b"     style="@style/KeyboardKey"       android:text="b"  android:layout_weight="1" />
            <Button android:id="@+id/kb_n"     style="@style/KeyboardKey"       android:text="n"  android:layout_weight="1" />
            <Button android:id="@+id/kb_m"     style="@style/KeyboardKey"       android:text="m"  android:layout_weight="1" />
            <Button android:id="@+id/kb_del"   style="@style/KeyboardKeyAccent" android:text="Del" android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 5: Modifiers + Space -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_ctrl"  style="@style/KeyboardKeyWide"   android:text="Ctrl"  android:layout_weight="1" />
            <Button android:id="@+id/kb_alt"   style="@style/KeyboardKeyWide"   android:text="Alt"   android:layout_weight="1" />
            <Button android:id="@+id/kb_win"   style="@style/KeyboardKeyWide"   android:text="Win"   android:layout_weight="1" />
            <Button android:id="@+id/kb_space" style="@style/KeyboardKeyWide"   android:text="Space" android:layout_weight="3" />
            <Button android:id="@+id/kb_tab"   style="@style/KeyboardKeyWide"   android:text="Tab"   android:layout_weight="1" />
            <Button android:id="@+id/kb_esc"   style="@style/KeyboardKeyWide"   android:text="Esc"   android:layout_weight="1" />
            <Button android:id="@+id/kb_enter" style="@style/KeyboardKeyAccent" android:text="↵"     android:layout_weight="1.5" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════
         DEV KEYBOARD TAB (Classified into clean sections)
    ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/devKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- SECTION 1: MODIFIERS -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_ctrl"  style="@style/DevModKey" android:text="CTRL"  android:layout_weight="1" />
            <Button android:id="@+id/dev_alt"   style="@style/DevModKey" android:text="ALT"   android:layout_weight="1" />
            <Button android:id="@+id/dev_shift" style="@style/DevModKey" android:text="SHIFT" android:layout_weight="1" />
            <Button android:id="@+id/dev_win"   style="@style/DevModKey" android:text="WIN"   android:layout_weight="1" />
            <Button android:id="@+id/dev_fn"    style="@style/DevModKey" android:text="FN"    android:layout_weight="1" />
            <Button android:id="@+id/dev_tab"   style="@style/DevModKey" android:text="TAB"   android:layout_weight="1" />
            <Button android:id="@+id/dev_esc"   style="@style/DevModKey" android:text="ESC"   android:layout_weight="1" />
            <Button android:id="@+id/dev_del"   style="@style/DevModKey" android:text="DEL"   android:layout_weight="1" />
        </LinearLayout>

        <!-- SECTION 2: NAVIGATION & BASIC CONTROL -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_home"  style="@style/KeyboardKey" android:text="Home"  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_end"   style="@style/KeyboardKey" android:text="End"   android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_pgup"  style="@style/KeyboardKey" android:text="PgUp"  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_pgdn"  style="@style/KeyboardKey" android:text="PgDn"  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_ins"   style="@style/KeyboardKey" android:text="Ins"   android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_bspc"  style="@style/KeyboardKeyAccent" android:text="⌫"  android:layout_weight="1.2" />
            <Button android:id="@+id/dev_enter" style="@style/KeyboardKeyAccent" android:text="↵"  android:layout_weight="1.2" />
        </LinearLayout>

        <!-- SECTION 3: FUNCTIONS (F1–F6) -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_f1" style="@style/DevFnKey" android:text="F1"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f2" style="@style/DevFnKey" android:text="F2"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f3" style="@style/DevFnKey" android:text="F3"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f4" style="@style/DevFnKey" android:text="F4"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f5" style="@style/DevFnKey" android:text="F5"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f6" style="@style/DevFnKey" android:text="F6"  android:layout_weight="1" />
        </LinearLayout>

        <!-- SECTION 3: FUNCTIONS (F7–F12) -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_f7"  style="@style/DevFnKey" android:text="F7"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f8"  style="@style/DevFnKey" android:text="F8"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f9"  style="@style/DevFnKey" android:text="F9"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f10" style="@style/DevFnKey" android:text="F10" android:layout_weight="1" />
            <Button android:id="@+id/dev_f11" style="@style/DevFnKey" android:text="F11" android:layout_weight="1" />
            <Button android:id="@+id/dev_f12" style="@style/DevFnKey" android:text="F12" android:layout_weight="1" />
        </LinearLayout>

        <!-- SECTION 4: SYMBOLS (Row 1) -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_brace_open"  style="@style/DevSymKey" android:text="{" android:layout_weight="1" />
            <Button android:id="@+id/dev_brace_close" style="@style/DevSymKey" android:text="}" android:layout_weight="1" />
            <Button android:id="@+id/dev_brack_open"  style="@style/DevSymKey" android:text="[" android:layout_weight="1" />
            <Button android:id="@+id/dev_brack_close" style="@style/DevSymKey" android:text="]" android:layout_weight="1" />
            <Button android:id="@+id/dev_paren_open"  style="@style/DevSymKey" android:text="(" android:layout_weight="1" />
            <Button android:id="@+id/dev_paren_close" style="@style/DevSymKey" android:text=")" android:layout_weight="1" />
            <Button android:id="@+id/dev_angle_open"  style="@style/DevSymKey" android:text="&lt;" android:layout_weight="1" />
            <Button android:id="@+id/dev_angle_close" style="@style/DevSymKey" android:text=">"  android:layout_weight="1" />
            <Button android:id="@+id/dev_backslash"   style="@style/DevSymKey" android:text="\\" android:layout_weight="1" />
        </LinearLayout>

        <!-- SECTION 4: SYMBOLS (Row 2) -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_pipe"      style="@style/DevSymKey" android:text="|" android:layout_weight="1" />
            <Button android:id="@+id/dev_amp"       style="@style/DevSymKey" android:text="&amp;" android:layout_weight="1" />
            <Button android:id="@+id/dev_star"      style="@style/DevSymKey" android:text="*" android:layout_weight="1" />
            <Button android:id="@+id/dev_percent"   style="@style/DevSymKey" android:text="%" android:layout_weight="1" />
            <Button android:id="@+id/dev_dollar"    style="@style/DevSymKey" android:text="$" android:layout_weight="1" />
            <Button android:id="@+id/dev_hash"      style="@style/DevSymKey" android:text="#" android:layout_weight="1" />
            <Button android:id="@+id/dev_at"        style="@style/DevSymKey" android:text="@" android:layout_weight="1" />
            <Button android:id="@+id/dev_tilde"     style="@style/DevSymKey" android:text="~" android:layout_weight="1" />
            <Button android:id="@+id/dev_backtick"  style="@style/DevSymKey" android:text="`" android:layout_weight="1" />
        </LinearLayout>

        <!-- SECTION 5: OPERATORS -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_eq_eq"       style="@style/DevSymKey" android:text="=="  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_not_eq"      style="@style/DevSymKey" android:text="!="  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_and"         style="@style/DevSymKey" android:text="&amp;&amp;" android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_or"          style="@style/DevSymKey" android:text="||"  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_arrow"       style="@style/DevSymKey" android:text="=>"  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_lt_eq"       style="@style/DevSymKey" android:text="&lt;=" android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_gt_eq"       style="@style/DevSymKey" android:text=">="  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_plus_plus"   style="@style/DevSymKey" android:text="++"  android:layout_weight="1" android:textSize="11sp" />
            <Button android:id="@+id/dev_minus_minus" style="@style/DevSymKey" android:text="--"  android:layout_weight="1" android:textSize="11sp" />
        </LinearLayout>

        <!-- SECTION 5: ASSIGNMENT OPERATORS -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_plus_eq"  style="@style/DevSymKey" android:text="+="  android:layout_weight="1" />
            <Button android:id="@+id/dev_minus_eq" style="@style/DevSymKey" android:text="-="  android:layout_weight="1" />
            <Button android:id="@+id/dev_star_eq"  style="@style/DevSymKey" android:text="*="  android:layout_weight="1" />
            <Button android:id="@+id/dev_slash_eq" style="@style/DevSymKey" android:text="/="  android:layout_weight="1" />
            <Button android:id="@+id/dev_dot"      style="@style/DevSymKey" android:text="."   android:layout_weight="0.8" />
            <Button android:id="@+id/dev_semi"     style="@style/DevSymKey" android:text=";"   android:layout_weight="0.8" />
            <Button android:id="@+id/dev_colon"    style="@style/DevSymKey" android:text=":"   android:layout_weight="0.8" />
        </LinearLayout>

        <!-- SECTION 6: HORIZONTAL SCROLL FOR PROFESSIONAL SHUTCUTS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="2dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- VS Code Shortcuts -->
                <Button android:id="@+id/chip_vs_palette" style="@style/KeyboardChip" android:text="Ctrl+Sh+P (Palette)" />
                <Button android:id="@+id/chip_vs_files"   style="@style/KeyboardChip" android:text="Ctrl+P (Files)" />
                <Button android:id="@+id/chip_vs_sidebar" style="@style/KeyboardChip" android:text="Ctrl+B (Sidebar)" />
                <Button android:id="@+id/chip_vs_term"    style="@style/KeyboardChip" android:text="Ctrl+` (Terminal)" />
                <Button android:id="@+id/chip_vs_format"  style="@style/KeyboardChip" android:text="Alt+Sh+F (Format)" />
                <Button android:id="@+id/chip_vs_comment" style="@style/KeyboardChip" android:text="Ctrl+/ (Comment)" />
                <Button android:id="@+id/chip_vs_def"     style="@style/KeyboardChip" android:text="F12 (Go Def)" />

                <!-- Android Studio Shortcuts -->
                <Button android:id="@+id/chip_as_everywhere" style="@style/KeyboardChip" android:text="Double-Shift" />
                <Button android:id="@+id/chip_as_class"      style="@style/KeyboardChip" android:text="Ctrl+N (Go Class)" />
                <Button android:id="@+id/chip_as_recent"     style="@style/KeyboardChip" android:text="Ctrl+E (Recents)" />
                <Button android:id="@+id/chip_as_format"     style="@style/KeyboardChip" android:text="Ctrl+Alt+L (Format)" />

                <!-- Cursor AI Shortcuts -->
                <Button android:id="@+id/chip_cur_edit"      style="@style/KeyboardChip" android:text="Ctrl+K (AI Edit)" />
                <Button android:id="@+id/chip_cur_chat"      style="@style/KeyboardChip" android:text="Ctrl+L (AI Chat)" />
                <Button android:id="@+id/chip_cur_composer"  style="@style/KeyboardChip" android:text="Ctrl+I (AI Composer)" />

                <!-- Terminal Shortcuts -->
                <Button android:id="@+id/chip_term_interrupt" style="@style/KeyboardChip" android:text="Ctrl+C (Interrupt)" />
                <Button android:id="@+id/chip_term_paste"     style="@style/KeyboardChip" android:text="Ctrl+V (Paste)" />
                <Button android:id="@+id/chip_term_cut"       style="@style/KeyboardChip" android:text="Ctrl+X (Cut)" />
                <Button android:id="@+id/chip_term_undo"      style="@style/KeyboardChip" android:text="Ctrl+Z (Undo)" />
                <Button android:id="@+id/chip_term_history"   style="@style/KeyboardChip" android:text="Ctrl+R (History)" />
                <Button android:id="@+id/chip_term_save"      style="@style/KeyboardChip" android:text="Ctrl+S (Save)" />

                <!-- System Shortcuts -->
                <Button android:id="@+id/chip_sys_alt_tab"   style="@style/KeyboardChip" android:text="Alt+Tab (Switch)" />
                <Button android:id="@+id/chip_sys_alt_f4"    style="@style/KeyboardChip" android:text="Alt+F4 (Close)" />
                <Button android:id="@+id/chip_sys_tab"       style="@style/KeyboardChip" android:text="Ctrl+Tab (Next)" />
                <Button android:id="@+id/chip_sys_tab_prev"  style="@style/KeyboardChip" android:text="Ctrl+Sh+Tab (Prev)" />



            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>
