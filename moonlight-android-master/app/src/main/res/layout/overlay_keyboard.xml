<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_keyboard.xml  (Professional DEV Keyboard - REDESIGNED)
  ─────────────────────────────────────────────────────────────────
  • Anchored to bottom of screen (layout_gravity="bottom").
  • Two tabs: NORMAL (QWERTY) and DEV (modifiers + symbols + shortcuts).
  • Drag handle on top bar allows repositioning vertically.
  • Compact mode collapses to a single input bar.
  • NEVER overlaps center content permanently — keyboard is dismissible.
  ─────────────────────────────────────────────────────────────────
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/bg_keyboard_panel"
    android:paddingTop="0dp"
    android:paddingBottom="4dp"
    android:elevation="18dp">

    <!-- ── TOP CONTROL BAR ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/keyboardTopBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_keyboard_topbar">

        <!-- Drag indicator -->
        <View
            android:id="@+id/keyboardDragHandle"
            android:layout_width="60dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_drag_handle"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />

        <!-- Tab: NORMAL -->
        <TextView
            android:id="@+id/tabNormal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="NORMAL"
            android:textColor="#BB86FC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_tab_active" />

        <!-- Tab: DEV -->
        <TextView
            android:id="@+id/tabDev"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="DEV"
            android:textColor="#888"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_tab_inactive" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Keyboard Scale Down (⌨-) -->
        <TextView
            android:id="@+id/btnKbScaleDown"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⌨-"
            android:textColor="#AAA"
            android:textSize="13sp"
            android:layout_marginEnd="4dp" />

        <!-- Keyboard Scale Up (⌨+) -->
        <TextView
            android:id="@+id/btnKbScaleUp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⌨+"
            android:textColor="#AAA"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <!-- One-Handed mode toggle (1H) -->
        <TextView
            android:id="@+id/btnKbOneHanded"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="1H"
            android:textColor="#AAA"
            android:textSize="13sp"
            android:layout_marginEnd="4dp" />

        <!-- Compact toggle -->
        <TextView
            android:id="@+id/btnKbCompact"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⊟"
            android:textColor="#AAA"
            android:textSize="16sp"
            android:layout_marginEnd="4dp" />

        <!-- Close -->
        <TextView
            android:id="@+id/btnKbClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#CF6679"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ── COMPACT BAR (hidden when full keyboard is visible) ─────── -->
    <LinearLayout
        android:id="@+id/compactBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ctrl" style="@style/KeyChip" android:id="@+id/compCtrl" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Alt" style="@style/KeyChip" android:id="@+id/compAlt" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Shift" style="@style/KeyChip" android:id="@+id/compShift" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tab" style="@style/KeyChip" android:id="@+id/compTab" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Esc" style="@style/KeyChip" android:id="@+id/compEsc" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⌫" style="@style/KeyChip" android:id="@+id/compBsp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="↵" style="@style/KeyChipAccent" android:id="@+id/compEnter" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════
         NORMAL KEYBOARD TAB
    ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/normalKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Row 1: Numbers -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_1"  style="@style/KeyboardKey" android:text="1"  android:layout_weight="1" />
            <Button android:id="@+id/kb_2"  style="@style/KeyboardKey" android:text="2"  android:layout_weight="1" />
            <Button android:id="@+id/kb_3"  style="@style/KeyboardKey" android:text="3"  android:layout_weight="1" />
            <Button android:id="@+id/kb_4"  style="@style/KeyboardKey" android:text="4"  android:layout_weight="1" />
            <Button android:id="@+id/kb_5"  style="@style/KeyboardKey" android:text="5"  android:layout_weight="1" />
            <Button android:id="@+id/kb_6"  style="@style/KeyboardKey" android:text="6"  android:layout_weight="1" />
            <Button android:id="@+id/kb_7"  style="@style/KeyboardKey" android:text="7"  android:layout_weight="1" />
            <Button android:id="@+id/kb_8"  style="@style/KeyboardKey" android:text="8"  android:layout_weight="1" />
            <Button android:id="@+id/kb_9"  style="@style/KeyboardKey" android:text="9"  android:layout_weight="1" />
            <Button android:id="@+id/kb_0"  style="@style/KeyboardKey" android:text="0"  android:layout_weight="1" />
            <Button android:id="@+id/kb_bspc" style="@style/KeyboardKeyAccent" android:text="⌫" android:layout_weight="1.5" />
        </LinearLayout>

        <!-- Row 2: QWERTY -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_q" style="@style/KeyboardKey" android:text="q" android:layout_weight="1" />
            <Button android:id="@+id/kb_w" style="@style/KeyboardKey" android:text="w" android:layout_weight="1" />
            <Button android:id="@+id/kb_e" style="@style/KeyboardKey" android:text="e" android:layout_weight="1" />
            <Button android:id="@+id/kb_r" style="@style/KeyboardKey" android:text="r" android:layout_weight="1" />
            <Button android:id="@+id/kb_t" style="@style/KeyboardKey" android:text="t" android:layout_weight="1" />
            <Button android:id="@+id/kb_y" style="@style/KeyboardKey" android:text="y" android:layout_weight="1" />
            <Button android:id="@+id/kb_u" style="@style/KeyboardKey" android:text="u" android:layout_weight="1" />
            <Button android:id="@+id/kb_i" style="@style/KeyboardKey" android:text="i" android:layout_weight="1" />
            <Button android:id="@+id/kb_o" style="@style/KeyboardKey" android:text="o" android:layout_weight="1" />
            <Button android:id="@+id/kb_p" style="@style/KeyboardKey" android:text="p" android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 3: ASDF -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_a"     style="@style/KeyboardKey"     android:text="a"    android:layout_weight="1" />
            <Button android:id="@+id/kb_s"     style="@style/KeyboardKey"     android:text="s"    android:layout_weight="1" />
            <Button android:id="@+id/kb_d"     style="@style/KeyboardKey"     android:text="d"    android:layout_weight="1" />
            <Button android:id="@+id/kb_f"     style="@style/KeyboardKey"     android:text="f"    android:layout_weight="1" />
            <Button android:id="@+id/kb_g"     style="@style/KeyboardKey"     android:text="g"    android:layout_weight="1" />
            <Button android:id="@+id/kb_h"     style="@style/KeyboardKey"     android:text="h"    android:layout_weight="1" />
            <Button android:id="@+id/kb_j"     style="@style/KeyboardKey"     android:text="j"    android:layout_weight="1" />
            <Button android:id="@+id/kb_k"     style="@style/KeyboardKey"     android:text="k"    android:layout_weight="1" />
            <Button android:id="@+id/kb_l"     style="@style/KeyboardKey"     android:text="l"    android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 4: ZXCV + arrows -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_shift" style="@style/KeyboardKeyAccent" android:text="⇧"  android:layout_weight="1.5" />
            <Button android:id="@+id/kb_z"     style="@style/KeyboardKey"       android:text="z"  android:layout_weight="1" />
            <Button android:id="@+id/kb_x"     style="@style/KeyboardKey"       android:text="x"  android:layout_weight="1" />
            <Button android:id="@+id/kb_c"     style="@style/KeyboardKey"       android:text="c"  android:layout_weight="1" />
            <Button android:id="@+id/kb_v"     style="@style/KeyboardKey"       android:text="v"  android:layout_weight="1" />
            <Button android:id="@+id/kb_b"     style="@style/KeyboardKey"       android:text="b"  android:layout_weight="1" />
            <Button android:id="@+id/kb_n"     style="@style/KeyboardKey"       android:text="n"  android:layout_weight="1" />
            <Button android:id="@+id/kb_m"     style="@style/KeyboardKey"       android:text="m"  android:layout_weight="1" />
            <Button android:id="@+id/kb_del"   style="@style/KeyboardKeyAccent" android:text="Del" android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 5: Modifiers + Space -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/kb_ctrl"  style="@style/KeyboardKeyWide"   android:text="Ctrl"  android:layout_weight="1" />
            <Button android:id="@+id/kb_alt"   style="@style/KeyboardKeyWide"   android:text="Alt"   android:layout_weight="1" />
            <Button android:id="@+id/kb_win"   style="@style/KeyboardKeyWide"   android:text="Win"   android:layout_weight="1" />
            <Button android:id="@+id/kb_space" style="@style/KeyboardKeyWide"   android:text="Space" android:layout_weight="3" />
            <Button android:id="@+id/kb_tab"   style="@style/KeyboardKeyWide"   android:text="Tab"   android:layout_weight="1" />
            <Button android:id="@+id/kb_esc"   style="@style/KeyboardKeyWide"   android:text="Esc"   android:layout_weight="1" />
            <Button android:id="@+id/kb_enter" style="@style/KeyboardKeyAccent" android:text="↵"     android:layout_weight="1.5" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════
         DEV KEYBOARD TAB
    ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/devKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Row 1: Modifier keys -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_ctrl"  style="@style/DevModKey" android:text="CTRL"  android:layout_weight="1" />
            <Button android:id="@+id/dev_alt"   style="@style/DevModKey" android:text="ALT"   android:layout_weight="1" />
            <Button android:id="@+id/dev_shift" style="@style/DevModKey" android:text="SHIFT" android:layout_weight="1" />
            <Button android:id="@+id/dev_tab"   style="@style/DevModKey" android:text="TAB"   android:layout_weight="1" />
            <Button android:id="@+id/dev_esc"   style="@style/DevModKey" android:text="ESC"   android:layout_weight="1" />
            <Button android:id="@+id/dev_win"   style="@style/DevModKey" android:text="WIN"   android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 2: F1–F6 -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_f1" style="@style/DevFnKey" android:text="F1"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f2" style="@style/DevFnKey" android:text="F2"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f3" style="@style/DevFnKey" android:text="F3"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f4" style="@style/DevFnKey" android:text="F4"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f5" style="@style/DevFnKey" android:text="F5"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f6" style="@style/DevFnKey" android:text="F6"  android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 3: F7–F12 -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_f7"  style="@style/DevFnKey" android:text="F7"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f8"  style="@style/DevFnKey" android:text="F8"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f9"  style="@style/DevFnKey" android:text="F9"  android:layout_weight="1" />
            <Button android:id="@+id/dev_f10" style="@style/DevFnKey" android:text="F10" android:layout_weight="1" />
            <Button android:id="@+id/dev_f11" style="@style/DevFnKey" android:text="F11" android:layout_weight="1" />
            <Button android:id="@+id/dev_f12" style="@style/DevFnKey" android:text="F12" android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 4: Code symbols -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_brace_open"  style="@style/DevSymKey" android:text="{" android:layout_weight="1" />
            <Button android:id="@+id/dev_brace_close" style="@style/DevSymKey" android:text="}" android:layout_weight="1" />
            <Button android:id="@+id/dev_brack_open"  style="@style/DevSymKey" android:text="[" android:layout_weight="1" />
            <Button android:id="@+id/dev_brack_close" style="@style/DevSymKey" android:text="]" android:layout_weight="1" />
            <Button android:id="@+id/dev_paren_open"  style="@style/DevSymKey" android:text="(" android:layout_weight="1" />
            <Button android:id="@+id/dev_paren_close" style="@style/DevSymKey" android:text=")" android:layout_weight="1" />
            <Button android:id="@+id/dev_angle_open"  style="@style/DevSymKey" android:text="&lt;" android:layout_weight="1" />
            <Button android:id="@+id/dev_angle_close" style="@style/DevSymKey" android:text=">"  android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 5: Operators -->
        <LinearLayout style="@style/KeyRow">
            <Button android:id="@+id/dev_eq_eq"   style="@style/DevSymKey" android:text="=="  android:layout_weight="1" />
            <Button android:id="@+id/dev_not_eq"  style="@style/DevSymKey" android:text="!="  android:layout_weight="1" />
            <Button android:id="@+id/dev_and"     style="@style/DevSymKey" android:text="&amp;&amp;" android:layout_weight="1" />
            <Button android:id="@+id/dev_or"      style="@style/DevSymKey" android:text="||"  android:layout_weight="1" />
            <Button android:id="@+id/dev_arrow"   style="@style/DevSymKey" android:text="=>"  android:layout_weight="1" />
            <Button android:id="@+id/dev_dot"     style="@style/DevSymKey" android:text="."   android:layout_weight="1" />
            <Button android:id="@+id/dev_semi"    style="@style/DevSymKey" android:text=";"   android:layout_weight="1" />
            <Button android:id="@+id/dev_colon"   style="@style/DevSymKey" android:text=":"   android:layout_weight="1" />
        </LinearLayout>

        <!-- Row 6: Shortcut chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:paddingBottom="2dp"
            android:gravity="center">

            <Button android:id="@+id/kb_chip_ctrl_c" style="@style/KeyboardChip" android:text="Ctrl+C" />
            <Button android:id="@+id/kb_chip_ctrl_v" style="@style/KeyboardChip" android:text="Ctrl+V" />
            <Button android:id="@+id/kb_chip_ctrl_x" style="@style/KeyboardChip" android:text="Ctrl+X" />
            <Button android:id="@+id/kb_chip_ctrl_z" style="@style/KeyboardChip" android:text="Ctrl+Z" />
            <Button android:id="@+id/kb_chip_ctrl_y" style="@style/KeyboardChip" android:text="Ctrl+`" />
            <Button android:id="@+id/kb_chip_ctrl_s" style="@style/KeyboardChip" android:text="Ctrl+S" />
            <Button android:id="@+id/kb_chip_ctrl_f" style="@style/KeyboardChip" android:text="Ctrl+F" />
            <Button android:id="@+id/kb_chip_ctrl_h" style="@style/KeyboardChip" android:text="Ctrl+Sh+P" />
            <Button android:id="@+id/kb_chip_alt_tab" style="@style/KeyboardChip" android:text="Ctrl+K" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
