<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#6600FF00" /> <!-- Green translucent when pressed -->
            <stroke android:width="2dp" android:color="#00FF00" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#22000000" /> <!-- Very dark translucent for glass effect -->
            <stroke android:width="1dp" android:color="#4400FF00" /> <!-- Subtle green border -->
        </shape>
    </item>
</selector>
