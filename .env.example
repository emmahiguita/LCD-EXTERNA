# SmartDisplay AI — Environment Variables
# Copy this file to .env.local and fill in the values.

# ─── Sunshine GameStream Server ───────────────────────────────────────
# Hostname/IP of the Sunshine server (default: localhost)
SUNSHINE_HOST=localhost

# Sunshine API port (default: 47990)
SUNSHINE_PORT=47990

# Sunshine API credentials (defaults are for local dev only — DO NOT use in production)
SUNSHINE_USER=admin
SUNSHINE_PASS=admin1234

# ─── Next.js ─────────────────────────────────────────────────────────
# NODE_ENV=development
