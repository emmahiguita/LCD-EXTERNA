{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SmartDisplay: Limpiar",
      "type": "shell",
      "command": "./gradlew",
      "args": ["sdClean"],
      "windows": { "command": ".\\gradlew.bat", "args": ["sdClean"] },
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "SmartDisplay: Compilar",
      "type": "shell",
      "command": "./gradlew",
      "args": ["sdBuild"],
      "windows": { "command": ".\\gradlew.bat", "args": ["sdBuild"] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "SmartDisplay: Correr",
      "type": "shell",
      "command": "./gradlew",
      "args": ["sdRun"],
      "windows": { "command": ".\\gradlew.bat", "args": ["sdRun"] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
