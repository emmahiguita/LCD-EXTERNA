<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartDisplayAI" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- ── PRIMARY ──────────────────────────────────────────────── -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_on_primary_container</item>

        <!-- ── SECONDARY ────────────────────────────────────────────── -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_on_secondary_container</item>

        <!-- ── TERTIARY ─────────────────────────────────────────────── -->
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_on_tertiary_container</item>

        <!-- ── ERROR ────────────────────────────────────────────────── -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_on_error</item>
        <item name="colorErrorContainer">@color/md_theme_error_container</item>
        <item name="colorOnErrorContainer">@color/md_theme_on_error_container</item>

        <!-- ── BACKGROUND / SURFACE + jerarquía tonal de contenedores ── -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_on_background</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_theme_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surface_container_highest</item>

        <!-- ── OUTLINE ──────────────────────────────────────────────── -->
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outline_variant</item>

        <!-- ── TIPOGRAFÍA (escala Material 3) ───────────────────────── -->
        <!-- Fuente de marca empaquetada (Roboto variable). Evita que una
             fuente serif del sistema (p. ej. Noto Serif de ColorOS) se
             filtre en títulos y textos: la app siempre usa Roboto. -->
        <item name="android:fontFamily">@font/roboto</item>
        <item name="fontFamily">@font/roboto</item>
        <!-- Roles de la escala tipográfica M3 forzados a Roboto (solo fuente). -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.SD.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.SD.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.SD.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.SD.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.SD.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.SD.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.SD.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.SD.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.SD.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.SD.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.SD.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.SD.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.SD.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.SD.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.SD.LabelSmall</item>

        <!-- ── FORMAS ───────────────────────────────────────────────── -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.SmartDisplay.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.SmartDisplay.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.SmartDisplay.Large</item>

        <!-- ── EFECTOS M3 (overlay tonal de elevación activo) ───────── -->
        <item name="elevationOverlayEnabled">true</item>

        <!-- Colores de texto del framework (usados por android.preference.* y
             widgets legacy) mapeados al esquema del tema para que Ajustes y
             cualquier pantalla legacy sean legibles en TODOS los temas. -->
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorTertiary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <!-- Los encabezados de categoría de android.preference.* usan colorAccent.
             Sin esto quedan casi invisibles sobre fondo oscuro. Se mapea al color
             primario del tema para que Ajustes sea legible en TODOS los temas. -->
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorControlNormal">?attr/colorOnSurfaceVariant</item>

        <!-- ── BARRAS DE SISTEMA edge-to-edge ───────────────────────── -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>

        <!-- ── TRANSICIONES (shared element / contenido) ────────────── -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.SmartDisplay.Activity</item>

        <!-- ── DIÁLOGOS Y ALERTAS GLASS OBSIDIAN ────────────────────── -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SmartDisplay.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.SmartDisplay.MaterialAlertDialog</item>
    </style>

    <!-- Tema Universo (Espacial/Neon - Material 3 Dark/Neon Mode) -->
    <style name="Theme.SmartDisplayAI.Universe" parent="Theme.SmartDisplayAI">
        <!-- Colores Primario y Secundario (Neon Violeta y Cian) -->
        <item name="colorPrimary">#9D4EDD</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#240046</item>
        <item name="colorOnPrimaryContainer">#E0AAFF</item>
        <item name="colorSecondary">#00F5FF</item>
        <item name="colorOnSecondary">#0B0914</item>
        <item name="colorSecondaryContainer">#003566</item>
        <item name="colorOnSecondaryContainer">#90E0EF</item>
        <item name="colorTertiary">#FF007F</item>
        <item name="colorOnTertiary">#FFFFFF</item>

        <!-- Fondos y Superficies (Gris Espacial muy Oscuro / Casi Negro) -->
        <item name="android:colorBackground">#050409</item>
        <item name="colorOnBackground">#E2E1E6</item>
        <item name="colorSurface">#0B0914</item>
        <item name="colorOnSurface">#F0EEF5</item>
        <item name="colorSurfaceVariant">#181528</item>
        <item name="colorOnSurfaceVariant">#CBC6D7</item>

        <!-- Tonalidades de Contenedores de Elevación de M3 -->
        <item name="colorSurfaceContainerLowest">#020104</item>
        <item name="colorSurfaceContainerLow">#08060E</item>
        <item name="colorSurfaceContainer">#0F0C1D</item>
        <item name="colorSurfaceContainerHigh">#17132B</item>
        <item name="colorSurfaceContainerHighest">#211B3B</item>

        <!-- Bordes y Separadores en Modo Oscuro -->
        <item name="colorOutline">#494554</item>
        <item name="colorOutlineVariant">#302C3D</item>

        <!-- Configuración de contraste en Barra de Estado (Modo Oscuro -> Íconos Claros) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

