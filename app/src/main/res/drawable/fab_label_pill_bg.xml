<?xml version="1.0" encoding="utf-8"?>
<!--
  fab_label_pill_bg.xml — Fondo pill translúcido para las etiquetas del FAB.
  Glassmorphism oscuro con borde sutil neon para que el texto sea legible
  sobre cualquier fondo de pantalla.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra difusa exterior -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="#2A000000"/>
        </shape>
    </item>
    <!-- Pill glassmorphism -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp"/>
            <solid android:color="#CC0D1525"/>
            <stroke android:width="1dp" android:color="#447B5CF6"/>
        </shape>
    </item>
</layer-list>
