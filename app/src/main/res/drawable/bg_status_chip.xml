<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de chip de estado: usa superficie adaptativa para modo claro/oscuro.
     @color/surface_high es adaptativo (light en values/, dark en values-night/). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface_high"/>
    <corners android:radius="24dp"/>
    <stroke
        android:width="1dp"
        android:color="@color/surface_border"/>
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="7dp"
        android:bottom="7dp"/>
</shape>