<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3078A6D8">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#262D4A68"
                android:centerColor="#140B1A28"
                android:endColor="#20040D18"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#3378A6D8" />
        </shape>
    </item>
</ripple>
