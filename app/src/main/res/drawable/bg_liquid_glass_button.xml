<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4066E5FF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="#4D357BB0"
                android:centerColor="#26102D4C"
                android:endColor="#3D061628"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#5578C8FF" />
        </shape>
    </item>
</ripple>
