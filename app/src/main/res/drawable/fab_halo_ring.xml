<?xml version="1.0" encoding="utf-8"?>
<!--
  fab_halo_ring.xml — Anillo orbital del FAB (wrapper 72/68dp).
  Azul eléctrico visible para coincidir con el diseño de referencia.
  Los anillos grandes del menú desplegado los dibuja RadialRingView en Canvas.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Borde exterior azul cian eléctrico -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1.5dp" android:color="#5500C6FF"/>
        </shape>
    </item>
    <!-- Capa 2: Borde interior ligeramente más tenue -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#330088CC"/>
        </shape>
    </item>
</layer-list>
