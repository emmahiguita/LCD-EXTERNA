<?xml version="1.0" encoding="utf-8"?>
<!--
  overlay_file_browser.xml — Explorador de archivos dentro del overlay.
  Permite elegir archivos para enviar al PC SIN salir de la proyección
  (no usa el selector del sistema). Oculto por defecto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fileBrowserOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_marginHorizontal="@dimen/sd_space_16"
    android:layout_marginTop="48dp"
    android:layout_marginBottom="48dp"
    android:minWidth="@dimen/sd_dialog_min_width"
    android:maxWidth="@dimen/sd_dialog_max_width"
    android:orientation="vertical"
    android:background="@drawable/performance_hud_bg"
    android:padding="@dimen/sd_space_12"
    android:elevation="95dp"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <!-- Cabecera: ruta actual + cerrar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/fbPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="/"
            android:textColor="#E6F2FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/fbToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/fb_mobile_root"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/key_button_bg"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/fbClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Cerrar"
            app:tint="#FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <!-- Lista de archivos/carpetas (se llena en código) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/fbList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Enviar -->
    <Button
        android:id="@+id/fbSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/fb_send_to_pc"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6D28D9" />

</LinearLayout>
