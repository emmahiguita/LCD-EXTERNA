<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_game.xml  v2.1 (Material 3 & Premium Polish)
  ─────────────────────────────────────────────────────
  Mejoras M3 Aplicadas:
  - MaterialButton (IconButton) para el botón Atrás.
  - CircularProgressIndicator M3 para el spinner de reconexión.
  - TextAppearances alineados a Google MDC.
  - Se mantiene la estructura estricta de capas y Z-Order (elevations).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:context=".Game">

    <!-- ===================================================== -->
    <!-- CAPA 1 - CAPTURA DE TOQUES                            -->
    <!-- Recibe todos los eventos táctiles (trackpad, gestos). -->
    <!-- StreamViewTransformController lo escucha primero.     -->
    <!-- ===================================================== -->
    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================================================== -->
    <!-- CAPA 2 - WRAPPER DE TRANSFORMACIÓN DEL STREAM         -->
    <!-- ===================================================== -->
    <FrameLayout
        android:id="@+id/streamTransformWrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- STREAM PRINCIPAL — dentro del wrapper transformable -->
        <com.limelight.ui.StreamView
            android:id="@+id/surfaceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:focusedByDefault="true"
            android:defaultFocusHighlightEnabled="false">

            <requestFocus />

        </com.limelight.ui.StreamView>

    </FrameLayout>

    <!-- ===================================================== -->
    <!-- CAPA 3 - HUD DE RENDIMIENTO                           -->
    <!-- ===================================================== -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/performanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/performance_hud_bg"
        android:fontFamily="monospace"
        android:textColor="#E6F2FF"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:gravity="start"
        android:preferKeepClear="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ===================================================== -->
    <!-- CAPA 4 - NOTIFICACIONES                               -->
    <!-- ===================================================== -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:padding="10dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="#FFFFFF"
        android:background="#99000000"
        android:gravity="end"
        android:preferKeepClear="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================================================== -->
    <!-- CAPA 5.5 - CURSOR ADAPTATIVO IA                       -->
    <!-- ===================================================== -->
    <com.limelight.ui.AdaptiveCursorView
        android:id="@+id/adaptiveCursorView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="55dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================================================== -->
    <!-- CAPA 6 - BARRA DE CONTROL DE VENTANAS WINDOWS         -->
    <!-- ===================================================== -->
    <include
        android:id="@+id/overlayWindowControls"
        layout="@layout/overlay_window_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ===================================================== -->
    <!-- CAPA 7 - SmartDisplay AI: RECONEXIÓN AUTOMÁTICA       -->
    <!-- ===================================================== -->
    <LinearLayout
        android:id="@+id/reconnectOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone"
        android:elevation="70dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Spinner de progreso M3 -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Texto de estado -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reconnectStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reconnect_label"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/roboto"
            android:letterSpacing="0.03" />

        <!-- Subtexto informativo -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reconnect_verifying"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- CAPA 8 - MODO VERTICAL HÍBRIDO (SmartDisplay AI)      -->
    <!-- ===================================================== -->
    <include
        android:id="@+id/portraitHybridLayout"
        layout="@layout/layout_portrait_hybrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="80dp"
        android:visibility="gone"/>

    <!-- ===================================================== -->
    <!-- CAPA 9 - CONTENEDOR DE OVERLAYS (FAB + Teclado)       -->
    <!-- ===================================================== -->
    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="99dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón Atrás (Material 3 IconButton) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToDesktop"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:contentDescription="Volver"
            android:elevation="10dp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_back_arrow"
            app:iconTint="#FFFFFF"
            app:iconSize="24dp"
            app:rippleColor="#40FFFFFF" />

        <!-- Explorador de archivos dentro del overlay -->
        <include
            android:id="@+id/fileBrowserOverlay"
            layout="@layout/overlay_file_browser" />

        <!-- Modo mouse: trackpad circular neón -->
        <com.limelight.ui.MouseModeCircle
            android:id="@+id/mouseModeCircle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:elevation="12dp"
            android:visibility="gone" />

        <!-- Teclado -->
        <include
            android:id="@+id/overlayKeyboard"
            layout="@layout/overlay_keyboard" />


        <!-- Edge pull-tab del Taskbar (borde izquierdo).
             Solo sobresale un pequeño tab de 6dp; deslizar hacia la derecha
             o tocar el tab revela el botón completo. Se oculta solo. -->
        <FrameLayout
            android:id="@+id/overlayToolButtons"
            android:layout_width="54dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="12dp">

            <!-- Tab visual que sobresale (6dp) para indicar que hay algo que deslizar -->
            <View
                android:id="@+id/taskbarEdgeTab"
                android:layout_width="6dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/taskbar_edge_tab_bg"
                android:elevation="13dp" />

            <!-- Botón real: empieza oculto (-48dp translateX), se desliza hacia la derecha -->
            <ImageView
                android:id="@+id/overlayBtnTaskbar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:padding="11dp"
                android:background="@drawable/overlay_tool_btn_bg"
                android:src="@drawable/ic_win_taskview"
                android:scaleType="centerInside"
                android:contentDescription="@string/taskbar_title"
                android:elevation="12dp"
                android:clickable="true"
                android:focusable="true"
                android:translationX="-54dp"
                app:tint="#E6ECF7" />
        </FrameLayout>

        <!-- FAB -->
        <include
            android:id="@+id/overlayFabMenu"
            layout="@layout/overlay_fab_menu" />

    </FrameLayout>

    <!-- Smart Taskbar: barra viva de ventanas del PC (oculta por defecto)
         Fuera del FrameLayout para soportar constraints y evitar soplamiento (overflow). -->
    <include
        android:id="@+id/overlaySmartTaskbar"
        layout="@layout/overlay_smart_taskbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="96dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:elevation="100dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintWidth_max="640dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
