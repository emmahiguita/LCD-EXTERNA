<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deviceDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030711"
    android:fitsSystemWindows="true"
    tools:context=".DeviceDetailActivity">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HEADER: Volver · Título del PC + Estado · Más Opciones         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Botón Volver Circular Glass -->
        <com.limelight.ui.glass.LiquidGlassCircleLayout
            android:id="@+id/detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/settings_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_back"
                android:src="@drawable/ic_back_arrow"
                app:tint="?attr/colorOnSurface" />
        </com.limelight.ui.glass.LiquidGlassCircleLayout>

        <!-- Información Central: Nombre del PC + Estado de Conexión -->
        <LinearLayout
            android:id="@+id/headerTitleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/detail_more"
            app:layout_constraintStart_toEndOf="@id/detail_back"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/roboto"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Emma" />

            <LinearLayout
                android:id="@+id/deviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/detail_status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_green_dot" />

                <TextView
                    android:id="@+id/detail_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/roboto"
                    android:includeFontPadding="false"
                    android:text="Conectado"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="Conectado" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón Más Opciones Circular Glass -->
        <com.limelight.ui.glass.LiquidGlassCircleLayout
            android:id="@+id/detail_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/options_button_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/options_button_desc"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorOnSurface" />
        </com.limelight.ui.glass.LiquidGlassCircleLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- CONTENIDO PRINCIPAL: Hero · Métricas · Acciones · Energía       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="28dp">

            <!-- 1. HERO PC ORB (Gran Esfera Liquid Glass 3D con Respiración) -->
            <com.limelight.ui.glass.LiquidGlassCircleLayout
                android:id="@+id/deviceHeroOrb"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/device_icon_desc">

                <ImageView
                    android:id="@+id/heroOrbIcon"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/device_icon_desc"
                    android:src="@drawable/ic_computer"
                    app:tint="?attr/colorPrimary" />
            </com.limelight.ui.glass.LiquidGlassCircleLayout>

            <!-- 2. MÉTRICAS (Cápsula Glass Cómoda y 100% Legible en Español) -->
            <LinearLayout
                android:id="@+id/systemMetrics"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_metrics"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <!-- Latencia / Ping -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stat_ping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="18 ms" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:text="Latencia"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1.2dp"
                    android:layout_height="32dp"
                    android:background="#3378A6D8" />

                <!-- Uso de CPU -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stat_cpu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="23%" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:text="CPU"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1.2dp"
                    android:layout_height="32dp"
                    android:background="#3378A6D8" />

                <!-- Uso de RAM / Memoria -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stat_ram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="42%" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:text="Memoria"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 3. ACCIONES PRINCIPALES (Círculos Glass Amplios sin Recortes) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Botón Circular Glass: Escritorio -->
                <com.limelight.ui.glass.LiquidGlassCircleLayout
                    android:id="@+id/card_desktop"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/detail_desktop_title">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/detail_desktop_title"
                            android:src="@drawable/ic_win_desktop"
                            app:tint="#7DDAFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="@string/detail_desktop_title"
                            android:textColor="#F8FAFC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="@string/detail_desktop_subtitle"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.limelight.ui.glass.LiquidGlassCircleLayout>

                <!-- Botón Circular Glass: Steam -->
                <com.limelight.ui.glass.LiquidGlassCircleLayout
                    android:id="@+id/card_steam"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/detail_steam_title">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/detail_steam_title"
                            android:src="@drawable/ic_steam"
                            app:tint="#66DFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="@string/detail_steam_title"
                            android:textColor="#F8FAFC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="@string/detail_steam_subtitle"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.limelight.ui.glass.LiquidGlassCircleLayout>

            </LinearLayout>

            <!-- 4. CONTROL DE ENERGÍA (4 Botones con Iconos Nítidos y Etiquetas en Español) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/roboto"
                android:gravity="center"
                android:text="@string/detail_power"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 1. Encender / WOL -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.limelight.ui.glass.LiquidGlassCircleLayout
                        android:id="@+id/power_on"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/detail_power_on">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/detail_power_on"
                            android:src="@drawable/ic_power_new"
                            app:tint="#10B981" />
                    </com.limelight.ui.glass.LiquidGlassCircleLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:text="@string/detail_power_on"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 2. Suspender -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.limelight.ui.glass.LiquidGlassCircleLayout
                        android:id="@+id/power_suspend"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/detail_power_suspend">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/detail_power_suspend"
                            android:src="@drawable/ic_bedtime"
                            app:tint="#38BDF8" />
                    </com.limelight.ui.glass.LiquidGlassCircleLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:text="@string/detail_power_suspend"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 3. Reiniciar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.limelight.ui.glass.LiquidGlassCircleLayout
                        android:id="@+id/power_restart"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/detail_power_restart">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/detail_power_restart"
                            android:src="@drawable/ic_refresh"
                            app:tint="#F59E0B" />
                    </com.limelight.ui.glass.LiquidGlassCircleLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:text="@string/detail_power_restart"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 4. Apagar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.limelight.ui.glass.LiquidGlassCircleLayout
                        android:id="@+id/power_off"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/detail_power_off">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/detail_power_off"
                            android:src="@drawable/ic_power_new"
                            app:tint="#EF4444" />
                    </com.limelight.ui.glass.LiquidGlassCircleLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto"
                        android:includeFontPadding="false"
                        android:text="@string/detail_power_off"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>