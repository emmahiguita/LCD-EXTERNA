<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030711"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HEADER: Botón Circular Glass Volver + Título & Estado           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ftHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#080E18"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.limelight.ui.glass.LiquidGlassCircleLayout
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/settings_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_back"
                android:src="@drawable/ic_back_arrow"
                app:tint="#F8FAFC" />
        </com.limelight.ui.glass.LiquidGlassCircleLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:includeFontPadding="false"
                android:text="@string/ft_title"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ft_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto"
                android:includeFontPadding="false"
                android:textColor="#7DDAFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="● Servidor activo" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1578A6D8" />

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- CONTENIDO: Tarjeta URL Server · Enviar Archivos · Recibidos     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="36dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                app:layout_constraintWidth_max="390dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <!-- 1. Tarjeta Glass con la URL para el navegador del PC -->
            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0F1826"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#3378A6D8"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lan"
                            app:tint="#7DDAFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:text="Conexión Directa WiFi"
                            android:textColor="#7DDAFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ft_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/roboto"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#F8FAFC"
                        android:textSize="13.5sp"
                        android:textIsSelectable="true"
                        tools:text="Abre en el navegador de tu PC:\n\nhttp://192.168.0.5:8080" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Sección Móvil -> Laptop (Compartir) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/roboto"
                android:text="@string/ft_share_section"
                android:textColor="#F8FAFC"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ft_btn_share"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_liquid_glass_button"
                android:stateListAnimator="@animator/card_press_scale"
                android:text="@string/ft_share_action"
                android:textColor="#F8FAFC"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="13dp"
                app:icon="@drawable/ic_files_overlay"
                app:iconSize="18dp"
                app:iconTint="#7DDAFF" />

            <LinearLayout
                android:id="@+id/ft_shared_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- 3. Sección Laptop -> Móvil (Recibidos) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/roboto"
                android:text="@string/ft_received_section"
                android:textColor="#F8FAFC"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ft_btn_received"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_liquid_glass_button_secondary"
                android:stateListAnimator="@animator/card_press_scale"
                android:text="@string/ft_received_refresh"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                app:backgroundTint="@null"
                app:cornerRadius="13dp" />

            <TextView
                android:id="@+id/ft_received"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/ft_received_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>