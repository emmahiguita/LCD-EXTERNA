<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/device_card"
    style="?attr/materialCardViewElevatedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="2.5dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:stateListAnimator="@animator/card_press_scale"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp">

        <!-- 1. Icono de PC con indicador de estado -->
        <FrameLayout
            android:id="@+id/badge_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/status_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_badge_device_3d"
                android:contentDescription="@string/device_icon_desc"
                android:padding="7.5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_computer"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                app:tint="?attr/colorOnSurfaceVariant" />

            <View
                android:id="@+id/online_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/online_dot"
                android:contentDescription="@string/online_status_desc"
                android:elevation="3dp" />
        </FrameLayout>

        <!-- 2. Información del Equipo (Nombre + Estado/App) -->
        <LinearLayout
            android:id="@+id/info_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/action_container"
            app:layout_constraintStart_toEndOf="@id/badge_container"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/grid_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/roboto"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Gaming-PC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/grid_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11.5sp"
                    tools:text="Listo para conectar" />

                <!-- IP oculta por defecto para no saturar visualmente -->
                <TextView
                    android:id="@+id/grid_ip_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/roboto"
                    android:textColor="?attr/colorOutline"
                    android:textSize="10.5sp"
                    android:visibility="gone"
                    tools:text="192.168.1.10" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_active_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/roboto"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="10.5sp"
                android:visibility="gone"
                tools:text="▶ En sesión activa" />

        </LinearLayout>

        <!-- 3. Contenedor de acciones & Spinner -->
        <FrameLayout
            android:id="@+id/action_container"
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ProgressBar
                android:id="@+id/grid_spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminateTint="?attr/colorPrimary"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_options"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@string/options_button_desc"
                app:icon="@drawable/ic_more_vert"
                app:iconSize="18dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <!-- Botón connect sutil si se pulsa el área directa -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>