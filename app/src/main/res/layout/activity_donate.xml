<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/donate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030711"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".DonateActivity">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HEADER: Botón Circular Glass Volver + Título & Subtítulo       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/donateHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#080E18"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.limelight.ui.glass.LiquidGlassCircleLayout
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/settings_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_back"
                android:src="@drawable/ic_back_arrow"
                app:tint="#F8FAFC" />
        </com.limelight.ui.glass.LiquidGlassCircleLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:includeFontPadding="false"
                android:text="@string/nav_donate"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto"
                android:includeFontPadding="false"
                android:text="Apoya el Desarrollo de SmartDisplay AI"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1578A6D8" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="28dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/donate_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                app:layout_constraintWidth_max="400dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Hero Heart Glass Orb -->
                <com.limelight.ui.glass.LiquidGlassCircleLayout
                    android:id="@+id/donateHeroOrb"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginTop="2dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_donate"
                        android:src="@drawable/ic_heart"
                        app:tint="#FF4D80" />
                </com.limelight.ui.glass.LiquidGlassCircleLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/donate_title"
                    android:textColor="#F8FAFC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/donate_desc"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/donate_bullets"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <!-- Tarjeta QR Glass de Alto Contraste -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#0F1826"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#3378A6D8"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/donate_name"
                            android:textColor="#F8FAFC"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <!-- Contenedor blanco para el código QR escaneable -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/donate_qr"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:layout_margin="8dp"
                                android:contentDescription="@string/donate_scan"
                                android:src="@drawable/qr_paypal" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/donate_scan"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/donate_amount_hint"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

                <!-- Botón Donar Principal (Liquid Glass) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/donate_paypal_btn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_liquid_glass_button"
                    android:stateListAnimator="@animator/card_press_scale"
                    android:text="@string/donate_paypal"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:cornerRadius="13dp"
                    app:icon="@drawable/ic_heart"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="#FF4D80" />

                <!-- Botones Secundarios: Compartir & Copiar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/donate_share_btn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_liquid_glass_button_secondary"
                        android:stateListAnimator="@animator/card_press_scale"
                        android:text="@string/donate_share"
                        android:textColor="#F8FAFC"
                        android:textSize="12.5sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_share"
                        app:iconSize="16dp"
                        app:iconTint="#7DDAFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/donate_copy_btn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_liquid_glass_button_secondary"
                        android:stateListAnimator="@animator/card_press_scale"
                        android:text="@string/donate_copy"
                        android:textColor="#F8FAFC"
                        android:textSize="12.5sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_copy"
                        app:iconSize="16dp"
                        app:iconTint="#7DDAFF" />
                </LinearLayout>

                <!-- Información del proyecto -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#0F1826"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#3378A6D8"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/donate_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto"
                                android:textColor="#F8FAFC"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="1.0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/roboto"
                                android:text="@string/donate_info_version"
                                android:textColor="#94A3B8"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center_vertical"
                            android:background="#3378A6D8" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto"
                                android:text="@string/donate_status_active"
                                android:textColor="#7DDAFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/roboto"
                                android:text="@string/donate_info_status"
                                android:textColor="#94A3B8"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
