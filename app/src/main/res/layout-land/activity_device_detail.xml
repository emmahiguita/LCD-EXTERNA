<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deviceDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030711"
    android:fitsSystemWindows="true"
    tools:context=".DeviceDetailActivity">

    <!-- Header Landscape -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.limelight.ui.glass.LiquidGlassCircleLayout
            android:id="@+id/detail_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/settings_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_back"
                android:src="@drawable/ic_back_arrow"
                app:tint="?attr/colorOnSurface" />
        </com.limelight.ui.glass.LiquidGlassCircleLayout>

        <LinearLayout
            android:id="@+id/headerTitleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/detail_more"
            app:layout_constraintStart_toEndOf="@id/detail_back"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/roboto"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Emma" />

            <LinearLayout
                android:id="@+id/deviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/detail_status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_green_dot" />

                <TextView
                    android:id="@+id/detail_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/roboto"
                    android:includeFontPadding="false"
                    android:text="Conectado"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="Conectado" />
            </LinearLayout>
        </LinearLayout>

        <com.limelight.ui.glass.LiquidGlassCircleLayout
            android:id="@+id/detail_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/options_button_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/options_button_desc"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorOnSurface" />
        </com.limelight.ui.glass.LiquidGlassCircleLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2 Columnas para Landscape -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                app:layout_constraintWidth_max="540dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Columna Izquierda: Hero Orb + Energía -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <com.limelight.ui.glass.LiquidGlassCircleLayout
                        android:id="@+id/deviceHeroOrb"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="@string/device_icon_desc">

                    <ImageView
                        android:id="@+id/heroOrbIcon"
                        android:layout_width="74dp"
                        android:layout_height="74dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/device_icon_desc"
                        android:src="@drawable/ic_computer"
                        app:tint="?attr/colorPrimary" />
                </com.limelight.ui.glass.LiquidGlassCircleLayout>

                <!-- Fila de Energía en Landscape -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/roboto"
                    android:gravity="center"
                    android:text="@string/detail_power"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Encender -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.limelight.ui.glass.LiquidGlassCircleLayout
                            android:id="@+id/power_on"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:contentDescription="@string/detail_power_on">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/detail_power_on"
                                android:src="@drawable/ic_power_new"
                                app:tint="#10B981" />
                        </com.limelight.ui.glass.LiquidGlassCircleLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:text="@string/detail_power_on"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Suspender -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.limelight.ui.glass.LiquidGlassCircleLayout
                            android:id="@+id/power_suspend"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:contentDescription="@string/detail_power_suspend">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/detail_power_suspend"
                                android:src="@drawable/ic_bedtime"
                                app:tint="#38BDF8" />
                        </com.limelight.ui.glass.LiquidGlassCircleLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:text="@string/detail_power_suspend"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Reiniciar -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.limelight.ui.glass.LiquidGlassCircleLayout
                            android:id="@+id/power_restart"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:contentDescription="@string/detail_power_restart">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/detail_power_restart"
                                android:src="@drawable/ic_refresh"
                                app:tint="#F59E0B" />
                        </com.limelight.ui.glass.LiquidGlassCircleLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:text="@string/detail_power_restart"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Apagar -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.limelight.ui.glass.LiquidGlassCircleLayout
                            android:id="@+id/power_off"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:contentDescription="@string/detail_power_off">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/detail_power_off"
                                android:src="@drawable/ic_power_new"
                                app:tint="#EF4444" />
                        </com.limelight.ui.glass.LiquidGlassCircleLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:text="@string/detail_power_off"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Columna Derecha: Métricas y Acciones Principales -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <!-- Métricas -->
                <LinearLayout
                    android:id="@+id/systemMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:background="@drawable/bg_glass_metrics"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stat_ping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="18 ms" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:text="Latencia"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1.2dp"
                        android:layout_height="26dp"
                        android:background="#3378A6D8" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stat_cpu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="23%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:text="CPU"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1.2dp"
                        android:layout_height="26dp"
                        android:background="#3378A6D8" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stat_ram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="42%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:text="Memoria"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Acciones Principales en Landscape -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Escritorio -->
                    <com.limelight.ui.glass.LiquidGlassCircleLayout
                        android:id="@+id/card_desktop"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@string/detail_desktop_title">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/detail_desktop_title"
                                android:src="@drawable/ic_win_desktop"
                                app:tint="#7DDAFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/roboto"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="@string/detail_desktop_title"
                                android:textColor="#F8FAFC"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="@font/roboto"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="@string/detail_desktop_subtitle"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.limelight.ui.glass.LiquidGlassCircleLayout>

                    <!-- Steam -->
                    <com.limelight.ui.glass.LiquidGlassCircleLayout
                        android:id="@+id/card_steam"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/detail_steam_title">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/detail_steam_title"
                                android:src="@drawable/ic_steam"
                                app:tint="#66DFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/roboto"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="@string/detail_steam_title"
                                android:textColor="#F8FAFC"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="@font/roboto"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="@string/detail_steam_subtitle"
                                android:textColor="#94A3B8"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </com.limelight.ui.glass.LiquidGlassCircleLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
