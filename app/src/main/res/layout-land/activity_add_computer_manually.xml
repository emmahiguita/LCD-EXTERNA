<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addPcRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030711"
    android:fitsSystemWindows="true">

    <!-- Header Landscape -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.limelight.ui.glass.LiquidGlassCircleLayout
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/settings_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/settings_back"
                android:src="@drawable/ic_back_arrow"
                app:tint="#F8FAFC" />
        </com.limelight.ui.glass.LiquidGlassCircleLayout>

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto"
            android:includeFontPadding="false"
            android:text="@string/addpc_title"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Añadir Equipo" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Contenido en 2 Columnas para Landscape -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/addPcScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp">

            <!-- Columna Izquierda: Hero Orb -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingEnd="16dp">

                <com.limelight.ui.glass.LiquidGlassCircleLayout
                    android:id="@+id/heroAddPcOrb"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:contentDescription="@string/device_icon_desc">

                    <ImageView
                        android:id="@+id/heroAddPcIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/device_icon_desc"
                        android:src="@drawable/ic_computer"
                        app:tint="#7DDAFF" />
                </com.limelight.ui.glass.LiquidGlassCircleLayout>

                <TextView
                    android:id="@+id/txtAddPcTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/roboto"
                    android:includeFontPadding="false"
                    android:text="Conexión Directa"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAddPcDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/roboto"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/addpc_desc"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Columna Derecha: Formulario Glass & Botón Conectar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInputContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="#0F1826"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#3378A6D8"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@string/addpc_hint"
                            android:src="@drawable/ic_lan"
                            app:tint="#7DDAFF" />

                        <EditText
                            android:id="@+id/hostTextView"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/roboto"
                            android:hint="@string/addpc_hint"
                            android:imeOptions="actionDone"
                            android:includeFontPadding="false"
                            android:inputType="textUri|textNoSuggestions"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="#F8FAFC"
                            android:textColorHint="#64748B"
                            android:textSize="14sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.limelight.ui.glass.LiquidGlassCircleLayout
                    android:id="@+id/btnConnect"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/addpc_connect">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:contentDescription="@string/addpc_connect"
                            android:src="@drawable/ic_add"
                            app:tint="#7DDAFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="@string/addpc_connect"
                            android:textColor="#F8FAFC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/roboto"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="Vincular"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.limelight.ui.glass.LiquidGlassCircleLayout>

                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/roboto"
                    android:includeFontPadding="false"
                    android:padding="6dp"
                    android:text="@android:string/cancel"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
